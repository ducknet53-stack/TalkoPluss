rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "ducknet53@gmail.com";
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin() || userId == 'system_talko_destek' || userId == 'system_talko_ai');
    }
    
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || (resource != null && resource.data.userId == request.auth.uid) || isAdmin());
    }
    
    match /verifications/{verifId} {
      allow read: if isAuthenticated() && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid));
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
      
      match /typing/{userId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    match /mail/{mailId} {
      allow create: if isAdmin();
    }
  }
}
