rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. GLOBAL HELPERS & PRIMITIVES (8 PILLARS)
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        ('email' in request.auth.token && (request.auth.token.email == 'ducknet53@gmail.com' || request.auth.token.email == 'goku1@gmail.com')) || 
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          'isAdmin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }

    function isNotBanned() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !( 'isBanned' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data ) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // 2. ENTITY SCHEMA VALIDATION BLUEPRINTS
    // ==========================================

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32
        && data.usernameLower is string && data.usernameLower.size() >= 2 && data.usernameLower.size() <= 32
        && data.email is string && data.email.size() <= 256;
    }

    function isValidToken(data) {
      return data.token is string && data.token.size() <= 256
        && data.userId is string && data.userId.size() <= 128;
    }

    function isValidStory(data) {
      return data.userId is string && data.userId.size() <= 128
        && ('mediaUrl' in data ? (data.mediaUrl is string && data.mediaUrl.size() <= 1024) : true)
        && ('type' in data ? (data.type is string && (data.type == 'image' || data.type == 'video' || data.type == 'text')) : true);
    }

    function isValidVerification(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.username is string && data.username.size() <= 64
        && data.reason is string && data.reason.size() <= 500;
    }

    function isValidChat(data) {
      return data.id is string && data.id.size() <= 128
        && data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 100
        && ('isGroup' in data ? data.isGroup is bool : true);
    }

    function isValidMessage(data) {
      return data.id is string && data.id.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && ('text' in data ? (data.text == null || (data.text is string && data.text.size() <= 5000)) : true);
    }

    function isValidReport(data) {
      return data.reporterId is string && data.reporterId.size() <= 128
        && data.reportedId is string && data.reportedId.size() <= 128
        && data.reason is string && data.reason.size() <= 1000;
    }

    function isValidModerationLog(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.chatId is string && data.chatId.size() <= 128
        && data.text is string && data.text.size() <= 5000;
    }

    // ==========================================
    // 3. SECURE ROUTING & CONTROLS
    // ==========================================

    // Admin Override: Full bypass for extreme state correction and safety.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUser(incoming()) && (isOwner(userId) || userId == 'system_talko_destek' || userId == 'system_talko_ai');
      allow update: if isAuthenticated() && (
        isOwner(userId) || 
        userId == 'system_talko_destek' || 
        userId == 'system_talko_ai'
      );
      allow delete: if isAuthenticated() && isOwner(userId);

      // Sub-collection: FCM device tokens
      match /tokens/{tokenId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // Sub-collection: Devices
      match /devices/{deviceId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    // Stories Collection
    match /stories/{storyId} {
      allow read: if isAuthenticated() && isNotBanned();
      allow create: if isAuthenticated() && isNotBanned() && isValidStory(incoming()) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isNotBanned() && resource != null && resource.data.userId == request.auth.uid && isValidStory(incoming());
      allow delete: if isAuthenticated() && isNotBanned() && resource != null && resource.data.userId == request.auth.uid;
    }

    // Verifications Collection (mavi tik applications)
    match /verifications/{verifId} {
      allow read: if isAuthenticated() && resource != null && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && isValidVerification(incoming()) && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource != null && resource.data.uid == request.auth.uid && isValidVerification(incoming());
      allow delete: if isAuthenticated() && resource != null && resource.data.uid == request.auth.uid;
    }

    // Chats Collection
    match /chats/{chatId} {
      allow read: if isAuthenticated() && isNotBanned() && (
        resource == null || request.auth.uid in resource.data.participants
      );
      allow create: if isAuthenticated() && isNotBanned() && isValidChat(incoming()) && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isAuthenticated() && isNotBanned() && (
        (resource != null && request.auth.uid in resource.data.participants) ||
        ('participants' in request.resource.data && request.auth.uid in request.resource.data.participants)
      );
      allow delete: if isAuthenticated() && isNotBanned() && resource != null && request.auth.uid in resource.data.participants;

      // Sub-collection: Messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isNotBanned() && (
          exists(/databases/$(database)/documents/chats/$(chatId)) && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isAuthenticated() && isNotBanned() && isValidMessage(incoming()) && (
          (
            exists(/databases/$(database)/documents/chats/$(chatId)) && 
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          ) ||
          request.resource.data.senderId == 'system_talko_destek' || 
          request.resource.data.senderId == 'system_talko_ai' || 
          request.resource.data.senderId == 'system_group_info'
        );
        allow update: if isAuthenticated() && isNotBanned() && (
          exists(/databases/$(database)/documents/chats/$(chatId)) && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow delete: if isAuthenticated() && isNotBanned() && (
          exists(/databases/$(database)/documents/chats/$(chatId)) && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
      }

      // Sub-collection: Typing Indicators
      match /typing/{userId} {
        allow read: if isAuthenticated() && isNotBanned() && (
          exists(/databases/$(database)/documents/chats/$(chatId)) && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow write: if isAuthenticated() && isNotBanned() && isOwner(userId);
      }
    }

    // Reports Collection
    match /reports/{reportId} {
      allow create: if isAuthenticated() && isValidReport(incoming());
      allow read: if isAuthenticated() && resource != null && resource.data.reporterId == request.auth.uid;
    }

    // Moderation Logs Collection
    match /moderation_logs/{logId} {
      allow create: if isAuthenticated() && isValidModerationLog(incoming());
      allow read: if isAuthenticated() && resource != null && resource.data.userId == request.auth.uid;
    }
  }
}
