rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Check if user has admin privileges
    function isAdmin() {
      return isAuthenticated() && (
        ("email" in request.auth.token && request.auth.token.email == "ducknet53@gmail.com") || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }

    // Check if the current user is NOT banned
    function isNotBanned() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !( 'isBanned' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data ) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        (isOwner(userId) && isNotBanned() && (
          !('isAdmin' in request.resource.data) || 
          request.resource.data.isAdmin == false || 
          (resource != null && 'isAdmin' in resource.data && request.resource.data.isAdmin == resource.data.isAdmin) ||
          isAdmin()
        )) || 
        userId == 'system_talko_destek' || 
        isAdmin()
      );
    }
    
    match /stories/{storyId} {
      allow read: if isAuthenticated() && isNotBanned();
      allow create: if isAuthenticated() && isNotBanned() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isNotBanned() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /verifications/{verifId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /chats/{chatId} {
      allow read: if isAuthenticated() && isNotBanned() && (isAdmin() || resource == null || request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && isNotBanned() && (isAdmin() || request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && isNotBanned() && (isAdmin() || request.auth.uid in resource.data.participants);
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isNotBanned() && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isAuthenticated() && isNotBanned() 
                     && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
                     && (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'system_talko_destek' || request.resource.data.senderId == 'system_talko_ai' || request.resource.data.senderId == 'system_group_info' || isAdmin());
        allow update: if isAuthenticated() && isNotBanned() && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow delete: if isAdmin();
      }
      
      match /typing/{userId} {
        allow read: if isAuthenticated() && isNotBanned() && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow write: if isAuthenticated() && isNotBanned() && isOwner(userId);
      }
    }
  }
}
