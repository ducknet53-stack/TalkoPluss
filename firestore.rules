rules_version = '2';

// ============================================================================
// TALKO APPLICATION FIRESTORE SECURITY RULES
// ============================================================================
// Comprehensive security rules covering user authentication, admin privileges,
// direct messaging, group chats, stories, device tokens, reports, verifications,
// and moderation logs.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // GLOBAL HELPER FUNCTIONS
    // ------------------------------------------------------------------------

    // Check if the request is authenticated by Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user matches the specified target userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the specified userId belongs to a designated system account
    function isSystemAccount(userId) {
      return userId == 'system_talko_destek' || userId == 'system_talko_ai';
    }

    // Check if user is an administrator based on email, token claims or user document
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && 'email' in request.auth.token && (
          request.auth.token.email == 'ducknet53@gmail.com' ||
          request.auth.token.email == 'goku1@gmail.com' ||
          request.auth.token.email == 'dev@talko.app' ||
          request.auth.token.email == 'admin@talko.app' ||
          request.auth.token.email == 'gogeta.blue053wow@gmail.com'
        )) ||
        (request.auth.token != null && 'admin' in request.auth.token && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)
      );
    }

    // Helper function to check if the current user is a chat participant
    function isChatParticipant(chatResource) {
      return isAuthenticated() && (
        chatResource == null ||
        !('participants' in chatResource.data) ||
        request.auth.uid in chatResource.data.participants ||
        isAdmin()
      );
    }

    // ------------------------------------------------------------------------
    // GLOBAL ADMIN OVERRIDE
    // Administrators have full read and write access across all collections.
    // ------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // 1. USERS COLLECTION (/users/{userId})
    // Handles user profiles, status, admin roles, and verification states.
    // ------------------------------------------------------------------------
    match /users/{userId} {
      // Any authenticated user can read user profiles (necessary for search & chats)
      allow read: if isAuthenticated();

      // Users can create their own profile document or system accounts can be created
      allow create: if isAuthenticated() && (
        isOwner(userId) ||
        isSystemAccount(userId) ||
        isAdmin()
      );

      // Profile updates permitted for the profile owner, system accounts, or admins
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        isSystemAccount(userId) ||
        isAdmin()
      );

      // Account deletion allowed for profile owner or admin
      allow delete: if isAuthenticated() && (
        isOwner(userId) ||
        isAdmin()
      );

      // ----------------------------------------------------------------------
      // 1a. FCM DEVICE TOKENS (/users/{userId}/tokens/{tokenId})
      // Firebase Cloud Messaging push notification tokens per user
      // ----------------------------------------------------------------------
      match /tokens/{tokenId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (
          isOwner(userId) ||
          isAdmin()
        );
      }

      // ----------------------------------------------------------------------
      // 1b. REGISTERED DEVICES (/users/{userId}/devices/{deviceId})
      // Active browser sessions and multi-device management
      // ----------------------------------------------------------------------
      match /devices/{deviceId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (
          isOwner(userId) ||
          isAdmin()
        );
      }
    }

    // ------------------------------------------------------------------------
    // 2. CHATS COLLECTION (/chats/{chatId})
    // One-on-one direct messages and multi-user group channels.
    // ------------------------------------------------------------------------
    match /chats/{chatId} {
      // Authenticated users can read chat rooms they participate in or explore
      allow read: if isAuthenticated();

      // Creation of new group or DM conversations
      allow create: if isAuthenticated();

      // Updates to chat metadata (last message, group settings, event states)
      allow update: if isAuthenticated();

      // Deletion of conversations
      allow delete: if isAuthenticated();

      // ----------------------------------------------------------------------
      // 2a. CHAT MESSAGES (/chats/{chatId}/messages/{messageId})
      // Text messages, images, audio recordings, and system announcements
      // ----------------------------------------------------------------------
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // ----------------------------------------------------------------------
      // 2b. TYPING INDICATORS (/chats/{chatId}/typing/{userId})
      // Real-time "typing..." status updates
      // ----------------------------------------------------------------------
      match /typing/{userId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (
          isOwner(userId) ||
          isAdmin()
        );
      }
    }

    // ------------------------------------------------------------------------
    // 3. STORIES COLLECTION (/stories/{storyId})
    // Ephemeral status posts and media stories (active for 24 hours).
    // ------------------------------------------------------------------------
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.get('userId', '') == request.auth.uid)
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.get('userId', '') == request.auth.uid)
      );
    }

    // ------------------------------------------------------------------------
    // 4. VERIFICATIONS COLLECTION (/verifications/{verifId})
    // Requests and records for verified blue tick badges ("mavi tik").
    // ------------------------------------------------------------------------
    match /verifications/{verifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // ------------------------------------------------------------------------
    // 5. REPORTS COLLECTION (/reports/{reportId})
    // User content reports submitted for moderation review.
    // ------------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // ------------------------------------------------------------------------
    // 6. MODERATION LOGS COLLECTION (/moderation_logs/{logId})
    // System and administrative activity logs for bans, warnings, and edits.
    // ------------------------------------------------------------------------
    match /moderation_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // ------------------------------------------------------------------------
    // 7. NOTIFICATIONS COLLECTION (/notifications/{notifId})
    // System alerts and push notification logs.
    // ------------------------------------------------------------------------
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ------------------------------------------------------------------------
    // 8. SYSTEM & APP CONFIGURATION (/app_config/{configId})
    // System-wide parameters and maintenance mode flags.
    // ------------------------------------------------------------------------
    match /app_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
