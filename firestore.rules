rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return request.auth != null && (
        ('email' in request.auth.token && request.auth.token.email == 'ducknet53@gmail.com') || 
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          'isAdmin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }
    function isNotBanned() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !( 'isBanned' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data ) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true
      );
    }

    // ADMIN OVERRIDE: Adminler her şeyi yapabilir, duyuru hatalarını kökten çözer.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // NORMAL KULLANICI KURALLARI
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isOwner(userId) || 
        userId == 'system_talko_destek' || 
        userId == 'system_talko_ai'
      );
      
      match /tokens/{token} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    match /stories/{storyId} {
      allow read: if isAuthenticated() && isNotBanned();
      allow create: if isAuthenticated() && isNotBanned() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isNotBanned() && resource != null && resource.data.userId == request.auth.uid;
    }
    
    match /verifications/{verifId} {
      allow read: if isAuthenticated() && resource != null && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }
    
    match /chats/{chatId} {
      allow read: if isAuthenticated() && isNotBanned() && (
        resource == null || request.auth.uid in resource.data.participants
      );
      allow create: if isAuthenticated() && isNotBanned() && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isAuthenticated() && isNotBanned() && (
        (resource != null && request.auth.uid in resource.data.participants) ||
        ('participants' in request.resource.data && request.auth.uid in request.resource.data.participants)
      );
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isNotBanned() && (
          exists(/databases/$(database)/documents/chats/$(chatId)) && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isAuthenticated() && isNotBanned() && (
          (
            exists(/databases/$(database)/documents/chats/$(chatId)) && 
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          ) ||
          request.resource.data.senderId == 'system_talko_destek' || 
          request.resource.data.senderId == 'system_talko_ai' || 
          request.resource.data.senderId == 'system_group_info'
        );
        allow update: if isAuthenticated() && isNotBanned() && (
          exists(/databases/$(database)/documents/chats/$(chatId)) && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
      }
      
      match /typing/{userId} {
        allow read: if isAuthenticated() && isNotBanned() && (
          exists(/databases/$(database)/documents/chats/$(chatId)) && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow write: if isAuthenticated() && isNotBanned() && isOwner(userId);
      }
    }
    
    match /reports/{reportId} {
      allow create: if request.auth != null;
    }
  }
}
