# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GITHUB_TOKEN: Required for Talko AI with GitHub Models (gpt-4o)
GITHUB_TOKEN="MY_GITHUB_TOKEN"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CLOUDINARY_CLOUD_NAME: Required for Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=laf0pciy

# CLOUDINARY_API_KEY: Cloudinary API key
CLOUDINARY_API_KEY=915233469293894

# CLOUDINARY_API_SECRET: Cloudinary API secret
CLOUDINARY_API_SECRET=EmQRTfF9vgUJk3PfeDooMjhOvTo

# VITE_FCM_VAPID_KEY: Your Firebase Cloud Messaging Web Push VAPID Key (Client)
